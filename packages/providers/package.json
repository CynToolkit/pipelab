{
  "name": "@pipelab/providers",
  "version": "1.0.0-beta.0",
  "description": "Built-in Release and Workflow providers shipped with Pipelab",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CynToolkit/pipelab.git",
    "directory": "packages/providers"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "format": "oxfmt .",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "build": "tsdown",
    "test": "vitest run",
    "test:construct": "vitest run src/construct",
    "test:electron": "vitest run src/electron",
    "test:godot": "vitest run src/godot",
    "test:tauri": "vitest run src/tauri",
    "test:steam": "vitest run src/steam",
    "test:itch": "vitest run src/itch",
    "test:poki": "vitest run src/poki"
  },
  "dependencies": {
    "@pipelab/constants": "workspace:*",
    "@pipelab/plugin-core": "workspace:*",
    "@pipelab/shared": "workspace:*",
    "@pipelab/workflow-runtime": "workspace:*",
    "adm-zip": "0.6.0",
    "electron": "39.8.10",
    "es-toolkit": "1.25.2",
    "execa": "9.4.1",
    "node-stream-zip": "1.15.0",
    "playwright": "1.62.1",
    "ts-deepmerge": "7.0.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@pipelab/test-utils": "workspace:*",
    "@pipelab/tsconfig": "workspace:*",
    "@types/node": "^24.12.2",
    "msw": "2.7.5",
    "tsdown": "0.21.2",
    "typescript": "5.9.3",
    "vitest": "3.1.4"
  }
}
