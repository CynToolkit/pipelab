{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    // No ^build ordering: every workspace package's main points at source
    // (./src/index.ts), so bundlers resolve sources directly and no package
    // needs another's dist first. Topological ordering is also incompatible
    // with the bundled model, where core-node statically depends on all
    // plugins while plugins depend back on core-node (a build-graph cycle
    // turbo rejects). tsc -b ordering for typecheck is unaffected (it follows
    // tsconfig references, and ^typecheck below is kept).
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**", ".vite/**", "out/**"]
    },
    "@pipelab/cli#build": {
      "dependsOn": ["^build"]
    },
    "@pipelab/core-node#build": {
      "dependsOn": []
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["out/**", "bin/**"]
    },
    "make": {
      "dependsOn": ["build"],
      "outputs": ["out/**"]
    },
    "publish": {
      "dependsOn": ["build"],
      "outputs": ["out/**"]
    },
    "test": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      // dependsOn is required so dependencies build declarations via tsc -b before apps typecheck
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map", "dist/tsconfig.tsbuildinfo"]
    },
    "format": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": ["SUPABASE_URL", "SUPABASE_ANON_KEY", "SUPABASE_PROJECT_ID", "POSTHOG_API_KEY"],
  "globalPassThroughEnv": [
    "DEBUG",
    "APPLE_TEAM_ID",
    "APPLE_ID",
    "APPLE_ID_PASSWORD",
    "APPLE_CODESIGN_IDENTITY",
    "TARGET_ARCH",
    "FORCE_UPDATE_CHECK",
    "PIPELAB_OVERRIDE_RELEASE",
    "PRERELEASE",
    "APP_UPDATE_URL"
  ]
}
