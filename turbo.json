{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    // Bundlers resolve workspace source exports directly.
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**", ".vite/**", "out/**"]
    },
    "@pipelab/cli#build": {
      "dependsOn": ["^build", "@pipelab/ui#build"],
      "outputs": ["dist/**"]
    },
    "@pipelab/core-node#build": {
      "dependsOn": []
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["out/**", "bin/**"]
    },
    "make": {
      "dependsOn": ["build"],
      "outputs": ["out/**"]
    },
    "publish": {
      "dependsOn": ["build"],
      "outputs": ["out/**"]
    },
    "test": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map", "dist/tsconfig.tsbuildinfo"]
    },
    "format": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:remote": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_PROJECT_ID",
    "PIPELAB_CLOUD_WORKER_URL",
    "POSTHOG_API_KEY"
  ],
  "globalPassThroughEnv": [
    "DEBUG",
    "APPLE_TEAM_ID",
    "APPLE_ID",
    "APPLE_ID_PASSWORD",
    "APPLE_CODESIGN_IDENTITY",
    "TARGET_ARCH",
    "FORCE_UPDATE_CHECK",
    "PIPELAB_OVERRIDE_RELEASE",
    "PRERELEASE",
    "APP_UPDATE_URL"
  ]
}
