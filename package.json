{
  "name": "pipelab-monorepo",
  "private": true,
  "license": "FSL-1.1-MIT",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev-remote": "turbo dev:remote",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "turbo format",
    "package": "pnpm --filter @pipelab/app package",
    "make": "pnpm --filter @pipelab/app make",
    "changeset": "changeset",
    "supa:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > packages/shared/src/database.types.ts",
    "docs": "pnpm --filter @pipelab/documentation dev",
    "docs:build": "pnpm --filter @pipelab/documentation build",
    "docs:preview": "pnpm --filter @pipelab/documentation preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@pipelab/constants": "workspace:*",
    "@pipelab/core-node": "workspace:*",
    "@pipelab/plugin-core": "workspace:*",
    "@pipelab/shared": "workspace:*",
    "@pipelab/tsconfig": "workspace:*",
    "@types/node": "24.12.2",
    "@types/tar": "^6.1.13",
    "cross-env": "7.0.3",
    "execa": "9.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nanoid": "5.0.8",
    "oxfmt": "0.40.0",
    "oxlint": "1.55.0",
    "turbo": "^2.8.15",
    "typescript": "5.9.3",
    "vitest": "3.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "resolutions": {
    "@codemirror/state": "6.4.1",
    "vue-demi": "0.14.10"
  },
  "packageManager": "pnpm@10.33.0"
}
