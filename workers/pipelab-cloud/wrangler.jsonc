{
  "name": "pipelab-cloud",
  "main": "index.ts",
  "compatibility_date": "2026-09-17",
  "dev": {
    "ip": "127.0.0.1",
  },
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_ANON_KEY",
      "SUPABASE_SERVICE_ROLE_KEY",
      "R2_ACCOUNT_ID",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "R2_BUCKET_NAME",
    ],
  },
}
