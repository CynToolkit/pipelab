{
  "name": "@pipelab/plugin-tauri",
  "version": "1.0.0-beta.28",
  "description": "Pipelab plugin for packaging apps with Tauri",
  "keywords": [
    "automation",
    "cross-platform",
    "desktop-app",
    "packaging",
    "pipelab",
    "pipelab-plugin",
    "pipeline",
    "rust",
    "tauri"
  ],
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CynToolkit/pipelab.git",
    "directory": "plugins/plugin-tauri"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.mjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "scripts": {
    "format": "oxfmt .",
    "lint": "oxlint .",
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@pipelab/constants": "workspace:*",
    "@pipelab/plugin-core": "workspace:*",
    "@pipelab/shared": "workspace:*",
    "@types/node": "^24.12.2",
    "electron": "32.1.2",
    "execa": "9.4.1",
    "ts-deepmerge": "7.0.1"
  },
  "devDependencies": {
    "@pipelab/tsconfig": "workspace:*",
    "tsdown": "0.21.2",
    "typescript": "5.9.3",
    "vitest": "3.1.4"
  },
  "pipelab": {
    "name": "Tauri",
    "description": "Pipelab plugin for packaging apps with Tauri",
    "icon": "./dist/public/tauri.webp"
  }
}
