{
  "name": "@pipelab/plugin-system",
  "version": "1.0.0-beta.14",
  "description": "Pipelab plugin for running shell commands and system operations",
  "keywords": [
    "automation",
    "cli",
    "command",
    "exec",
    "pipelab",
    "pipelab-plugin",
    "pipeline",
    "scripting",
    "shell",
    "system"
  ],
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CynToolkit/pipelab.git",
    "directory": "plugins/plugin-system"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.mjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "scripts": {
    "format": "oxfmt .",
    "lint": "oxlint .",
    "build": "tsdown"
  },
  "dependencies": {
    "@pipelab/plugin-core": "workspace:*",
    "@types/node": "^24.12.2"
  },
  "devDependencies": {
    "@pipelab/tsconfig": "workspace:*",
    "tsdown": "0.21.2",
    "typescript": "5.9.3"
  },
  "pipelab": {
    "name": "System",
    "description": "Pipelab plugin for running shell commands and system operations",
    "icon": {
      "type": "icon",
      "icon": "mdi-cog-outline"
    }
  }
}
