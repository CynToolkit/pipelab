{
  "name": "@pipelab/plugin-nvpatch",
  "version": "1.0.0-beta.37",
  "description": "Pipelab plugin for patching NW.js game exports",
  "keywords": [
    "automation",
    "construct3",
    "desktop",
    "game-export",
    "nw.js",
    "nwjs",
    "patch",
    "pipelab",
    "pipelab-plugin",
    "pipeline"
  ],
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CynToolkit/pipelab.git",
    "directory": "plugins/plugin-nvpatch"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.mjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "scripts": {
    "format": "oxfmt .",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "build": "tsdown"
  },
  "dependencies": {
    "@pipelab/plugin-core": "workspace:*",
    "@types/node": "^24.12.2",
    "execa": "9.4.1"
  },
  "devDependencies": {
    "@pipelab/tsconfig": "workspace:*",
    "tsdown": "0.21.2",
    "typescript": "5.9.3"
  },
  "pipelab": {
    "name": "NVPatch",
    "description": "Pipelab plugin for patching NW.js game exports",
    "icon": {
      "type": "icon",
      "icon": "mdi-wrench"
    }
  }
}
