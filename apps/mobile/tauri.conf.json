{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pipelab",
  "version": "2.0.0",
  "identifier": "app.pipelab.mobile",
  "build": {
    "beforeDevCommand": "pnpm build:ui && vite preview --host 0.0.0.0 --port 1420 --outDir src/ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:ui",
    "frontendDist": "../src/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pipelab",
        "width": 400,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "mobile": {
      "target": "all",
      "ios": {
        "developmentTeam": "",
        "packageType": "ad-hoc",
        "isWirelessDevicesEnabled": false
      },
      "android": {
        "minSdkVersion": 24
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["desktop", "mobile"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
