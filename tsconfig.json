{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "bundler",
    "inlineSourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@@/*": [
        "./src/shared/*"
      ],
      "@main/*": [
        "./src/main/*"
      ],
      "@renderer/*": [
        "./src/renderer/*"
      ],
      "@pipelab/*": [
        "./src/shared/libs/*"
      ],
      "fancy-ansi": ["./node_modules/fancy-ansi/dist/main.d.ts"],
      "quickjs-emscripten-sync": ["./node_modules/quickjs-emscripten-sync/dist/index.d.ts"],
      "tinykeys": ["./node_modules/tinykeys/dist/tinykeys.d.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.test.mjs",
    "./assets/tauri/template/app/src-tauri",
    "dist",
    "out",
    "./assets"
  ]
}
