{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "inlineSourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@@/*": [
        "./src/shared/*"
      ],
      "@main/*": [
        "./src/main/*"
      ],
      "@renderer/*": [
        "./src/renderer/*"
      ],
      "@pipelab/*": [
        "./src/shared/libs/*"
      ],
      "@polar-sh/sdk/models/components/subscription": [
        "./node_modules/@polar-sh/sdk/dist/esm/models/components/subscription.d.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.test.mjs",
    "./assets/tauri/template/app/src-tauri",
    "dist",
    "out",
    "./assets"
  ]
}
